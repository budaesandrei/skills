#!/bin/sh
# Builds its environment on first run. Requires uv: https://docs.astral.sh/uv/
DIR=$(cd "$(dirname "$0")" && pwd -P)
UV=$(command -v uv || echo "$HOME/.local/bin/uv")
if [ ! -x "$UV" ]; then
  echo "agent-secrets: uv is required. Install it from https://docs.astral.sh/uv/getting-started/installation/" >&2
  exit 127
fi
UV_PROJECT_ENVIRONMENT="${AGENT_SECRETS_VENV:-$HOME/.agent-secrets/venv}" exec "$UV" run --quiet --project "$DIR" --python 3.12 python "$DIR/agent_secrets.py" "$@"
